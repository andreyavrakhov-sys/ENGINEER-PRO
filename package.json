{
  "name": "engineer-pro",
  "version": "1.0.0",
  "private": true,
  "description": "ENGINEER PRO desktop with free-provider fallback and GitHub auto-updates",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "check": "node --check main.js && node --check preload.js && node --check shared/sync.js && node --check android/www/app.js"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ua.engineerpro.desktop",
    "productName": "ENGINEER PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!android/**",
      "!.github/**",
      "!test-*.js",
      "!README*.md",
      "!BUILD_FIX*.md",
      "!START_HERE*.md",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "ENGINEER_PRO_Setup_${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "andreyavrakhov-sys",
        "repo": "ENGINEER-PRO",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": false,
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1",
    "@napi-rs/canvas": "0.1.80"
  }
}
