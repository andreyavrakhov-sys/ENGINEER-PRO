{
  "name": "engineer-pro",
  "version": "0.9.10",
  "private": true,
  "description": "ENGINEER PRO desktop with free-provider fallback and GitHub auto-updates",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node test-compare.js && node test-specification.js && node test-pdf-enhanced.js && node test-reconciliation-091.js && node test-reconciliation-092.js && node test-xlsx-093.js && node test-reconciliation-094.js && node test-technical-096.js"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ua.engineerpro.desktop",
    "productName": "ENGINEER PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "document-reader.js",
      "preload.js",
      "index.html",
      "package.json",
      "update-config.json",
      "compare-engine.js",
      "estimate-importer.js",
      "sunset-tower.png",
      "specification-analyzer.js",
      "pdf-enhanced.js",
      "xlsx-report.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "ENGINEER_PRO_Setup_${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "andreyavrakhov-sys",
        "repo": "ENGINEER-PRO",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": false,
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1",
    "@napi-rs/canvas": "0.1.80"
  }
}
